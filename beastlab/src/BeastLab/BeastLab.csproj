<Project Sdk="Microsoft.NET.Sdk">
  <!-- BONELAB MelonLoader mod (Il2Cpp, .NET 6). Game types are resolved by reflection at runtime
       from sheets/hooks.json, so this builds without the game's generated assemblies. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BeastLab</AssemblyName>
    <RootNamespace>BeastLab</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.6.6" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.4.5" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
